{
  "name": "woope-companion",
  "version": "0.2.0",
  "description": "Tray-only desktop companion that mirrors Woope activity as Discord Rich Presence",
  "private": true,
  "main": "dist/main/index.js",
  "license": "UNLICENSED",
  "scripts": {
    "icons:generate": "node scripts/generate-icons.js",
    "copy:static": "node scripts/copy-static.js",
    "build": "tsc -p tsconfig.json && npm run copy:static",
    "dev": "npm run build && concurrently -k -n tsc,electron -c blue,green \"tsc -w -p tsconfig.json\" \"nodemon --watch dist --delay 300ms --exec electron .\"",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.7",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "eu.woope.companion",
    "productName": "Woope Companion",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Woope-Companion-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "Woope-Companion.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "Woope-Companion.${ext}",
      "mimeTypes": [
        "x-scheme-handler/woope-companion"
      ]
    },
    "protocols": [
      {
        "name": "Woope Companion",
        "schemes": [
          "woope-companion"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
